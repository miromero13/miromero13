# GitHub Personal Access Token (PAT)
# Generá tu token clásico o fine-grained en: https://github.com/settings/tokens
# Permisos recomendados para gestión y mantenimiento de tus repos:
# - repo (Full control of private and public repositories)
# - read:org (si pertenecés a alguna organización)
# - user (lectura de datos de perfil)

GITHUB_PERSONAL_ACCESS_TOKEN=tu_token_aqui
